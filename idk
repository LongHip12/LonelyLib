    function Tabs:SetMainTab(a, b, c)
        if not a or not b or not c then
            warn("Error: Window:SetMainTab requires exactly 3 tabs.")
            return
        end
        MainTabSetFlag = true
        local firstTab = TabListContainer[1]
        if firstTab then
            CurrentTabContainer = firstTab.Meta
            firstTab.Page.Visible = true
            firstTab.Button.BackgroundColor3 = Themes["Panel Color"]
            firstTab.Button.UIStroke.Color = Themes["Main Color"]
        end
    end

