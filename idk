        local function SelectTabInternal(targetTabMeta)
            CurrentTabContainer = targetTabMeta
            for _, t in pairs(TabListContainer) do
                t.Page.Visible = (t.Meta == targetTabMeta)
                if t.Meta == targetTabMeta then
                    t.Button.BackgroundColor3 = Themes["Panel Color"]
                    t.Button.TextColor3 = Themes["Text Color"]
                    t.Button.UIStroke.Color = Themes["Main Color"]
                else
                    t.Button.BackgroundColor3 = Themes["Background Color"]
                    t.Button.TextColor3 = Themes["Subtext Color"]
                    t.Button.UIStroke.Color = Themes["Border Color"]
                end
            end
        end

        TabButton.MouseButton1Click:Connect(function()
            if CurrentTabContainer ~= TabMeta then
                SelectTabInternal(TabMeta)
            end
        end)

        return TabMeta
