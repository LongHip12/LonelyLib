                    TextSize = 9,
                    Font = Enum.Font.Gotham,
                    RichText = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = SliderFrame,
                })

                local TrackOuter = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 14),
                    Position = UDim2.new(0, 0, 0, 16),
                    BackgroundColor3 = Themes["SliderTrack"],
                    BorderSizePixel = 0,
                    Parent = SliderFrame,
                })
                Corner(TrackOuter, UDim.new(0, 7))

                local TrackFill = Create("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = Themes["SliderFill"],
                    BorderSizePixel = 0,
                    Parent = TrackOuter,
                })
                Corner(TrackFill, UDim.new(0, 7))

                local Knob = Create("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    BackgroundColor3 = Themes["SliderKnob"],
                    BorderSizePixel = 0,
                    ZIndex = 2,
                    Parent = TrackOuter,
                })
                Corner(Knob, UDim.new(1, 0))
                Stroke(Knob, Themes["Border"], 1)

                local ValueLabel = Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 14),
                    Position = UDim2.new(0, 0, 0, 33),
                    BackgroundTransparency = 1,
                    Text = tostring(value),
                    TextColor3 = Themes["Text"],
                    TextSize = 10,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    Parent = SliderFrame,
                })

                local function UpdateSlider(newVal)
                    newVal = math.clamp(Round(newVal, elemIncrease), elemMin, elemMax)
                    value = newVal
                    local pct = (value - elemMin) / (elemMax - elemMin)
                    TweenObj(TrackFill, {Size = UDim2.new(pct, 0, 1, 0)}, 0.08)
                    TweenObj(Knob, {Position = UDim2.new(pct, 0, 0.5, 0)}, 0.08)
                    ValueLabel.Text = tostring(value)
                    pcall(elemCallback, value)
                end

                UpdateSlider(elemDefault)

                local sliding = false
                TrackOuter.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                    end
                end)
                TrackOuter.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local trackPos = TrackOuter.AbsolutePosition.X
                        local trackSize = TrackOuter.AbsoluteSize.X
                        local relX = math.clamp(input.Position.X - trackPos, 0, trackSize)
                        local pct = relX / trackSize
                        UpdateSlider(elemMin + (elemMax - elemMin) * pct)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)

                local SliderObj = {}
                function SliderObj:Set(val)
                    UpdateSlider(val)
                end
                function SliderObj:Get()
                    return value
                end
                return SliderObj
            end

