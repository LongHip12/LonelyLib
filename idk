                local InputFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 46),
                    BackgroundColor3 = Themes["InputBackground"],
                    BorderSizePixel = 0,
                    Parent = ElementsContainer,
                })
                Corner(InputFrame, UDim.new(0, 4))
                Stroke(InputFrame, Themes["InputBorder"], 1)
                Padding(InputFrame, 4, 4, 6, 6)

                Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 14),
                    BackgroundTransparency = 1,
                    Text = elemTitle,
                    TextColor3 = Themes["SubText"],
                    TextSize = 9,
                    Font = Enum.Font.Gotham,
                    RichText = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = InputFrame,
                })

                local InputBox = Create("TextBox", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Position = UDim2.new(0, 0, 0, 16),
                    BackgroundColor3 = Themes["TertiaryBackground"],
                    Text = "",
                    PlaceholderText = elemPlaceholder,
                    PlaceholderColor3 = Themes["SubText"],
                    TextColor3 = Themes["Text"],
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    BorderSizePixel = 0,
                    Parent = InputFrame,
                })
                Corner(InputBox, UDim.new(0, 3))
                Stroke(InputBox, Themes["BorderDim"], 1)
                Padding(InputBox, 0, 0, 5, 5)

                InputBox.FocusLost:Connect(function()
                    pcall(elemCallback, InputBox.Text)
                end)

                local InputObj = {}
                function InputObj:Set(val)
                    InputBox.Text = val
                end
                function InputObj:Get()
                    return InputBox.Text
                end
                return InputObj
            end

            function Section:AddLabel(text, side)
                local elemSide = side or "Left"

                local LabelFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundColor3 = Themes["LabelBackground"],
                    BorderSizePixel = 0,
                    Parent = ElementsContainer,
                })
                Corner(LabelFrame, UDim.new(0, 4))
                Stroke(LabelFrame, Themes["LabelBorder"], 1)
                Padding(LabelFrame, 3, 3, 7, 7)

                Create("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Themes["Text"],
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    RichText = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    Parent = LabelFrame,
                })
            end

            function Section:AddButton(cfg)
                local elemTitle = cfg.Title or "Button"
                local elemCallback = cfg.Callback or function() end
                local elemSide = cfg.Side or "Left"

                local BtnFrame = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundColor3 = Themes["ButtonBackground"],
                    Text = "",
                    BorderSizePixel = 0,
                    Parent = ElementsContainer,
                })
                Corner(BtnFrame, UDim.new(0, 4))
                Stroke(BtnFrame, Themes["ButtonBorder"], 1)

                Create("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "<b>" .. elemTitle .. "</b>",
                    TextColor3 = Themes["Text"],
                    TextSize = 10,
                    Font = Enum.Font.GothamBold,
                    RichText = true,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    Parent = BtnFrame,
                })

                BtnFrame.MouseButton1Click:Connect(function()
                    TweenObj(BtnFrame, {BackgroundColor3 = Themes["NavSelected"]}, 0.08)
                    task.delay(0.14, function()
                        TweenObj(BtnFrame, {BackgroundColor3 = Themes["ButtonBackground"]}, 0.1)
                    end)
                    pcall(elemCallback)
                end)
            end

            function Section:AddButtonHolder(cfg)
                local elemTitle = cfg.Title or "Holder"
                local elemButtons = cfg.Buttons or {}
                local elemSide = cfg.Side or "Left"

                local HolderFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Themes["ButtonHolderBackground"],
                    BorderSizePixel = 0,
                    Parent = ElementsContainer,
                })
                Corner(HolderFrame, UDim.new(0, 4))
                Stroke(HolderFrame, Themes["ButtonHolderBorder"], 1)
                Padding(HolderFrame, 4, 5, 5, 5)

                Create("UIListLayout", {
                    FillDirection = Enum.FillDirection.Vertical,
                    HorizontalAlignment = Enum.HorizontalAlignment.Center,
                    Padding = UDim.new(0, 4),
                    Parent = HolderFrame,
                })

                Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    Text = "<b>" .. elemTitle .. "</b>",
                    TextColor3 = Themes["Text"],
                    TextSize = 11,
                    Font = Enum.Font.GothamBold,
                    RichText = true,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    Parent = HolderFrame,
                })

                local BtnGrid = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Parent = HolderFrame,
                })
                local BtnGridLayout = Create("UIGridLayout", {
                    CellSize = UDim2.new(0.31, 0, 0, 28),
                    CellPaddingX = UDim.new(0, 4),
                    CellPaddingY = UDim.new(0, 4),
                    HorizontalAlignment = Enum.HorizontalAlignment.Center,
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = BtnGrid,
                })

                for i, btnCfg in ipairs(elemButtons) do
                    local bTitle = btnCfg.Title or "Btn"
                    local bCallback = btnCfg.Callback or function() end

                    local HBtn = Create("TextButton", {
                        BackgroundColor3 = Themes["ButtonHolderButtonBackground"],
                        Text = "<b>" .. bTitle .. "</b>",
                        TextColor3 = Themes["Text"],
                        TextSize = 8,
                        Font = Enum.Font.GothamBold,
                        RichText = true,
                        BorderSizePixel = 0,
                        LayoutOrder = i,
                        Parent = BtnGrid,
                    })
                    Corner(HBtn, UDim.new(0, 3))
                    Stroke(HBtn, Themes["ButtonHolderBorder"], 1)

                    HBtn.MouseButton1Click:Connect(function()
                        TweenObj(HBtn, {BackgroundColor3 = Themes["Border"]}, 0.08)
                        task.delay(0.15, function()
                            TweenObj(HBtn, {BackgroundColor3 = Themes["ButtonHolderButtonBackground"]}, 0.1)
                        end)
                        pcall(bCallback)
                    end)
                end
            end

            function Section:AddImageLabel(cfg)
                local elemTitle = cfg.Title or ""
                local elemImage = cfg.Image or ""
                local elemSide = cfg.Side or "Left"

                local ImgFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 100),
                    BackgroundColor3 = Themes["ImageLabelBackground"],
                    BorderSizePixel = 0,
                    Parent = ElementsContainer,
                })
                Corner(ImgFrame, UDim.new(0, 4))
                Stroke(ImgFrame, Themes["BorderDim"], 1)

                local ImgLabel = Create("ImageLabel", {
                    AnchorPoint = Vector2.new(0.5, 0),
                    Size = UDim2.new(0.7, 0, 0, 76),
                    Position = UDim2.new(0.5, 0, 0, 4),
                    BackgroundColor3 = Themes["TertiaryBackground"],
                    Image = elemImage,
                    ScaleType = Enum.ScaleType.Fit,
                    BorderSizePixel = 0,
                    Parent = ImgFrame,
                })
                Corner(ImgLabel, UDim.new(0, 4))

                Create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 1),
                    Size = UDim2.new(1, -8, 0, 16),
                    Position = UDim2.new(0.5, 0, 1, -2),
                    BackgroundTransparency = 1,
                    Text = elemTitle,
                    TextColor3 = Themes["SubText"],
                    TextSize = 8,
                    Font = Enum.Font.Gotham,
                    RichText = true,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    Parent = ImgFrame,
                })
            end

            return Section
        end

        table.insert(TabObjects, tabData)
        return tabData
    end

    local mainTabsRegistered = false
    local mainTabChecked = false

    task.delay(2, function()
        if not mainTabChecked then
            mainTabChecked = true
            if not mainTabsRegistered then
                warn("[HoHoLib] SetMainTab was not called. Please call Window:SetMainTab(tabA, tabB, tabC) with exactly 3 tabs.")
            end
        end
    end)

    function Window:SetMainTab(tabA, tabB, tabC)
        if not tabA or not tabB or not tabC then
            warn("[HoHoLib] SetMainTab requires exactly 3 tabs. Usage: Window:SetMainTab(tabA, tabB, tabC)")
            return
        end
        mainTabsRegistered = true
        mainTabChecked = true

        for _, child in ipairs(MainTileHolder:GetChildren()) do
            if not child:IsA("UIListLayout") then child:Destroy() end
        end

        local tabs = {tabA, tabB, tabC}
        for _, tabData in ipairs(tabs) do
            local tile = Create("TextButton", {
                Size = UDim2.new(0, 74, 0, 80),
                BackgroundColor3 = Themes["MainTileBackground"],
                Text = "",
                BorderSizePixel = 0,
                Parent = MainTileHolder,
            })
            Corner(tile, UDim.new(0, 5))
            Stroke(tile, Themes["MainTileBorder"], 1)

            local tileInner = Create("Frame", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Parent = tile,
            })
            Padding(tileInner, 4, 4, 4, 4)
            Create("UIListLayout", {
                FillDirection = Enum.FillDirection.Vertical,
                HorizontalAlignment = Enum.HorizontalAlignment.Center,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                Padding = UDim.new(0, 3),
                Parent = tileInner,
            })

            local iconFrame = Create("Frame", {
                Size = UDim2.new(0, 34, 0, 34),
                BackgroundColor3 = Themes["TertiaryBackground"],
                BorderSizePixel = 0,
                Parent = tileInner,
            })
            Corner(iconFrame, UDim.new(1, 0))
            Stroke(iconFrame, Themes["BorderDim"], 1)
            Create("ImageLabel", {
                Size = UDim2.new(1, -6, 1, -6),
                Position = UDim2.new(0, 3, 0, 3),
                BackgroundTransparency = 1,
                Image = tabData.Image or "",
                ScaleType = Enum.ScaleType.Fit,
                Parent = iconFrame,
            })

            Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 14),
                BackgroundTransparency = 1,
                Text = "<b>" .. tabData.Title .. "</b>",
                TextColor3 = Themes["Text"],
                TextSize = 8,
                Font = Enum.Font.GothamBold,
                RichText = true,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = tileInner,
            })

            Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 20),
                BackgroundTransparency = 1,
                Text = tabData.Description or "",
                TextColor3 = Themes["SubText"],
                TextSize = 7,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextWrapped = true,
                Parent = tileInner,
            })

            tile.MouseButton1Click:Connect(function()
                TweenObj(tile, {BackgroundColor3 = Themes["NavSelected"]}, 0.08)
                task.delay(0.15, function()
                    TweenObj(tile, {BackgroundColor3 = Themes["MainTileBackground"]}, 0.1)
                end)
                OpenTabView(tabData)
            end)
        end
    end

    ShowPage("Home")

    ActiveWindow = Window
    return Window
end

return Library
