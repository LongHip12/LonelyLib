local function Create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then
            obj[k] = v
        end
    end
    if props.Parent then
        obj.Parent = props.Parent
    end
    return obj
end

local function Stroke(parent, color, thickness)
    local existing = parent:FindFirstChildOfClass("UIStroke")
    if existing then existing:Destroy() end
    return Create("UIStroke", {
        Color = color or Themes["Border"],
        Thickness = thickness or 1,
        Parent = parent,
    })
end

local function Corner(parent, radius)
    return Create("UICorner", {
        CornerRadius = radius or UDim.new(0, 4),
        Parent = parent,
    })
end

local function Padding(parent, t, b, l, r)
    return Create("UIPadding", {
        PaddingTop = UDim.new(0, t or 4),
        PaddingBottom = UDim.new(0, b or 4),
        PaddingLeft = UDim.new(0, l or 4),
        PaddingRight = UDim.new(0, r or 4),
        Parent = parent,
    })
end

local function TweenObj(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

