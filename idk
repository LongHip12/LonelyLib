                DropButton.AutoButtonColor = false
                DropButton.Parent = DropFrame

                local DropBtnCorner = Instance.new("UICorner")
                DropBtnCorner.Parent = DropButton
                DropBtnCorner.CornerRadius = UDim.new(0, 6)

                local DropdownList = Instance.new("Frame")
                DropdownList.Size = UDim2.new(0.4, 0, 0, 0)
                DropdownList.Position = UDim2.new(0.6, 0, 1, 0)
                DropdownList.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                DropdownList.ClipsDescendants = true
                DropdownList.Visible = false
                DropdownList.Parent = DropFrame
                DropdownList.ZIndex = 5

                local DropListCorner = Instance.new("UICorner")
                DropListCorner.Parent = DropdownList
                DropListCorner.CornerRadius = UDim.new(0, 6)

                local DropListStroke = Instance.new("UIStroke")
                DropListStroke.Parent = DropdownList
                DropListStroke.Color = Themes["Main Color"]
                DropListStroke.Thickness = 1

                local ListLayout = Instance.new("UIListLayout")
                ListLayout.Parent = DropdownList
                ListLayout.Padding = UDim.new(0, 2)
                ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

                local DropItems = {}
                local IsMulti = dropConfig.Multi or false
                local SelectedValues = {}

                local function UpdateDropdownText()
                    if IsMulti then
                        local text = ""
                        for _, v in pairs(SelectedValues) do
                            text = text .. v .. ", "
                        end
                        DropButton.Text = string.sub(text, 1, -3)
                        if DropButton.Text == "" then DropButton.Text = "Select" end
                    else
                        DropButton.Text = SelectedValues[1] or "Select"
                    end
                end

                local function CreateOption(val)
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Size = UDim2.new(1, 0, 0, 25)
                    OptBtn.BackgroundTransparency = 1
                    OptBtn.Text = val
                    OptBtn.TextColor3 = Themes["Subtext Color"]
                    OptBtn.TextSize = 12
                    OptBtn.Font = Enum.Font.Gotham
                    OptBtn.AutoButtonColor = false
                    OptBtn.Parent = DropdownList

                    OptBtn.MouseEnter:Connect(function()
                        OptBtn.TextColor3 = Themes["Text Color"]
                    end)
                    OptBtn.MouseLeave:Connect(function()
                        OptBtn.TextColor3 = Themes["Subtext Color"]
                    end)
                    OptBtn.MouseButton1Click:Connect(function()
                        local exists = table.find(SelectedValues, val)
                        if IsMulti then
                            if exists then
                                table.remove(SelectedValues, exists)
                            else
                                table.insert(SelectedValues, val)
                            end
                        else
                            SelectedValues = {val}
                            DropdownList.Visible = false
                        end
                        UpdateDropdownText()
                        if dropConfig.Callback then
                            if IsMulti then dropConfig.Callback(SelectedValues) else dropConfig.Callback(val) end
                        end
                    end)
                    return OptBtn
                end

                for _, v in pairs(dropConfig.Values) do
                    table.insert(DropItems, CreateOption(v))
                end

                DropButton.MouseButton1Click:Connect(function()
                    DropdownList.Visible = not DropdownList.Visible
                    if DropdownList.Visible then
                        local h = (table.getn(dropConfig.Values) * 27)
                        DropdownList.Size = UDim2.new(0.4, 0, 0, h)
                    else
                        DropdownList.Size = UDim2.new(0.4, 0, 0, 0)
                    end
                end)

                if dropConfig.Default then
                    if IsMulti then
                        local split = string.split(dropConfig.Default, ",")
                        for _, val in pairs(split) do
                            table.insert(SelectedValues, string.gsub(val, "%s+", ""))
                        end
                    else
                        SelectedValues = {dropConfig.Default}
                    end
                    UpdateDropdownText()
                end

                table.insert(SectionFunctions, DropFrame)
            end

