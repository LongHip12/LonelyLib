function Library:Notify(config)
    if not NotificationHolder then return end
    local title = config.Title or ""
    local content = config.Content or ""
    local duration = config.Duration or 4
    local image = config.Image or ""

    local nFrame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 72),
        BackgroundColor3 = Themes["NotificationBackground"],
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = NotificationHolder,
    })
    Corner(nFrame, UDim.new(0, 5))
    Stroke(nFrame, Themes["NotificationBorder"], 1)

    local innerRow = Create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Parent = nFrame,
    })
    Padding(innerRow, 6, 6, 7, 7)

    local hasImage = image ~= ""

    if hasImage then
        local imgLabel = Create("ImageLabel", {
            Size = UDim2.new(0, 42, 0, 42),
            Position = UDim2.new(0, 0, 0.5, -21),
            BackgroundColor3 = Themes["SecondaryBackground"],
            Image = image,
            ScaleType = Enum.ScaleType.Fit,
            BorderSizePixel = 0,
            Parent = innerRow,
        })
        Corner(imgLabel, UDim.new(0, 4))
        Stroke(imgLabel, Themes["BorderDim"], 1)
    end

    local textX = hasImage and UDim2.new(0, 50, 0, 0) or UDim2.new(0, 0, 0, 0)
    local textW = hasImage and UDim2.new(1, -50, 0, 22) or UDim2.new(1, 0, 0, 22)

    Create("TextLabel", {
        Size = textW,
        Position = textX,
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Themes["Text"],
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        RichText = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = innerRow,
    })

    local contentW = hasImage and UDim2.new(1, -50, 0, 30) or UDim2.new(1, 0, 0, 30)
    local contentY = hasImage and UDim2.new(0, 50, 0, 24) or UDim2.new(0, 0, 0, 24)

    Create("TextLabel", {
        Size = contentW,
        Position = contentY,
        BackgroundTransparency = 1,
        Text = content,
        TextColor3 = Themes["SubText"],
        TextSize = 11,
        Font = Enum.Font.Gotham,
        RichText = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = innerRow,
    })

    local barLine = Create("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Themes["Border"],
        BorderSizePixel = 0,
        Parent = nFrame,
    })
    Corner(barLine, UDim.new(0, 2))

    task.delay(duration, function()
        TweenObj(nFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.25)
        task.delay(0.28, function()
            nFrame:Destroy()
        end)
    end)
end

