                SliDrag.AutoButtonColor = false
                SliDrag.Parent = SliBar

                local SliDragCorner = Instance.new("UICorner")
                SliDragCorner.Parent = SliDrag
                SliDragCorner.CornerRadius = UDim.new(1, 0)

                local Min = sliConfig.Min or 0
                local Max = sliConfig.Max or 100
                local Inc = sliConfig.Increase or 1
                local CurrentValue = sliConfig.Default or Min

                local function updateSlider(xPos)
                    local BarSize = SliBar.AbsoluteSize.X
                    local relative = math.clamp((xPos - SliBar.AbsolutePosition.X) / BarSize, 0, 1)
                    local val = Min + ((Max - Min) * relative)
                    val = math.floor(val / Inc + 0.5) * Inc
                    if val > Max then val = Max end
                    if val < Min then val = Min end
                    CurrentValue = val
                    SliValue.Text = tostring(val)
                    local newSize = (val - Min) / (Max - Min)
                    SliFill.Size = UDim2.new(newSize, 0, 1, 0)
                    SliDrag.Position = UDim2.new(newSize, 0, 0.5, 0)
                    if sliConfig.Callback then sliConfig.Callback(val) end
                end

                local dragging = false
                SliDrag.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                    end
                end)
                SliDrag.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
                SliBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        updateSlider(input.Position.X)
                        dragging = true
                    end
                end)
                game:GetService("UserInputService").InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateSlider(input.Position.X)
                    end
                end)

                if sliConfig.Default then
                    local initial = (sliConfig.Default - Min) / (Max - Min)
                    SliFill.Size = UDim2.new(initial, 0, 1, 0)
                    SliDrag.Position = UDim2.new(initial, 0, 0.5, 0)
                    SliValue.Text = tostring(sliConfig.Default)
                end

                table.insert(SectionFunctions, SliFrame)
            end

