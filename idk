        if input == DragInput then
            Main.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + (input.Position.X - DragStart.X), StartPos.Y.Scale, StartPos.Y.Offset + (input.Position.Y - DragStart.Y))
