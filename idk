            function Section:AddSlider(cfg)
                local elemTitle = cfg.Title or "Slider"
                local elemMin = cfg.Min or 0
                local elemMax = cfg.Max or 100
                local elemDefault = cfg.Default or elemMin
                local elemIncrease = cfg.Increase or 1
                local elemCallback = cfg.Callback or function() end
                local elemSide = cfg.Side or "Left"

                local value = elemDefault

                local function Round(num, inc)
                    if inc <= 0 then return num end
                    return math.round(num / inc) * inc
                end

                local SliderFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 54),
                    BackgroundColor3 = Themes["TertiaryBackground"],
                    BorderSizePixel = 0,
                    Parent = ElementsContainer,
